{
  "permissions": {
    "allow": [
      "Read(data/**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(.claude/rules/**)",
      "Write(CHANGELOG.md)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git commit *)",
      "Bash(git checkout *)"
    ],
    "deny": [
      "Write(data/**)",
      "Write(SONOVA_README.md)",
      "Write(SONOVA_TASK.md)"
    ]
  },
  "env": {
    "PYTHONPATH": "${workspaceFolder}"
  }
}